      "training-fold mean datum correction",
      "training-fold mean datum plus trend correction"
    ],
    "fold_map": "frozen folds/v1.json through folds/v5.json",
    "harsher_split": "five contiguous spatial X-midpoint blocks, held out one block at a time",
